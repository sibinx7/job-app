// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            Int       @id @default(autoincrement())
  first_name    String
  middle_name   String?
  last_name     String
  email         String    @unique
  password_hash String    @unique
  phone         String    @unique
  dob           DateTime?
  gender        String?   @default("MALE")
  country_code  Int
  country       String
  pincode       String?
  state         String?
  role          String    @default("JOB_SEEKER")
  status        String    @default("INACTIVE")
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  company_staff         CompanyStaff[]
  reviews               CompanyReview[]
  userAppliedJobs       UserAppliedJob[]
  userFavoriteCompanies userFavoriteCompany[]
}

model CompanyAddress {
  id             Int       @id @default(autoincrement())
  company_id     Int
  address        String?
  address_line_1 String?
  address_line_2 String?
  country_code   Int
  country        String
  pincode        String?
  state          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
}

model Company {
  id                    Int                   @id @default(autoincrement())
  name                  String
  company_code          String?               @unique
  registration_number   String?               @unique
  email                 String                @unique
  phone                 String                @unique
  country_code          Int
  country               String
  pincode               String?
  state                 String?
  employee_count        Int?
  website               String?
  description           String?
  address               String?
  address_line_1        String?
  address_line_2        String?
  logo_url              String?
  created_at            DateTime              @default(now())
  updated_at            DateTime?             @updatedAt
  deleted_at            DateTime?
  locations             CompanyAddress[]
  staff                 CompanyStaff[]
  reviews               CompanyReview[]
  company_technologies  CompanyTechnology[]
  jobs                  Job[]
  userFavoriteCompanies userFavoriteCompany[]
  companyLocations      CompanyLocation[]
}

model CompanyStaff {
  id         Int       @id @default(autoincrement())
  company_id Int       @unique
  user_id    Int       @unique
  role       String
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?
  company    Company   @relation(fields: [company_id], references: [id])
  user       User      @relation(fields: [user_id], references: [id])
  jobs       Job[]

  @@index([company_id])
  @@index([user_id])
}

model CompanyReview {
  id         Int       @id @default(autoincrement())
  company_id Int
  user_id    Int
  rating     Int
  review     String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?
  anonymous  Boolean   @default(false)

  company Company @relation(fields: [company_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([company_id])
  @@index([user_id])
}

model CompanyTechnology {
  id         Int       @id @default(autoincrement())
  company_id Int
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  company               Company                               @relation(fields: [company_id], references: [id])
  programming_languages CompanyTechnologyProgramingLanguage[]
  frameworks            CompanyTechnologyFramework[]

  @@index([company_id])
}

model CompanyTechnologyProgramingLanguage {
  id                      Int       @id @default(autoincrement())
  company_technology_id   Int
  programming_language_id Int
  created_at              DateTime  @default(now())
  updated_at              DateTime? @updatedAt
  deleted_at              DateTime?

  company_technology   CompanyTechnology  @relation(fields: [company_technology_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programming_language ProgramingLanguage @relation(fields: [programming_language_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_technology_id, programming_language_id])
  @@index([company_technology_id])
  @@index([programming_language_id])
}

model CompanyTechnologyFramework {
  id                       Int       @id @default(autoincrement())
  company_technology_id    Int
  programming_framework_id Int
  created_at               DateTime  @default(now())
  updated_at               DateTime? @updatedAt
  deleted_at               DateTime?

  company_technology    CompanyTechnology   @relation(fields: [company_technology_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programming_framework ProgramingFramework @relation(fields: [programming_framework_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_technology_id, programming_framework_id])
  @@index([company_technology_id])
  @@index([programming_framework_id])
}

model ProgramingLanguage {
  id                                      Int                                   @id @default(autoincrement())
  name                                    String                                @unique
  description                             String?
  created_at                              DateTime                              @default(now())
  updated_at                              DateTime?                             @updatedAt
  deleted_at                              DateTime?
  frameworks                              ProgramingFramework[]
  company_technology_programing_languages CompanyTechnologyProgramingLanguage[]
  jobProgrammingLanguages                 JobProgrammingLanguage[]
}

model ProgramingFramework {
  id                      Int       @id @default(autoincrement())
  name                    String    @unique
  description             String?
  programming_language_id Int
  created_at              DateTime  @default(now())
  updated_at              DateTime? @updatedAt
  deleted_at              DateTime?

  programming_language          ProgramingLanguage           @relation(fields: [programming_language_id], references: [id])
  company_technology_frameworks CompanyTechnologyFramework[]
  jobProgrammingFrameworks      JobProgrammingFramework[]

  @@index([programming_language_id])
}

model CompanyLocation {
  id         Int     @id @default(autoincrement())
  company    Company @relation(fields: [company_id], references: [id])
  company_id Int

  name           String
  address        String
  address_line_1 String
  address_line_2 String
  city           String
  state          String
  country        String
  country_code   Int
  pincode        String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  deleted_at     DateTime?
  jobLocations   JobLocation[]

  @@index([name])
}

model JobLocation {
  id Int @id @default(autoincrement())

  job_id              Int             @unique
  job                 Job             @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company_location_id Int             @unique
  company_location    CompanyLocation @relation(fields: [company_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id Int

  posted_by    CompanyStaff @relation(fields: [posted_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posted_by_id Int

  userAppliedJobs          UserAppliedJob[]
  jobProgrammingLanguages  JobProgrammingLanguage[]
  jobProgrammingFrameworks JobProgrammingFramework[]

  locations  JobLocation[]
  salary_min Float?
  salary_max Float?
  job_type   String?

  experience_min Int
  experience_max Int

  notice_period_max Int?
  notice_perion_min Int?

  is_remote Boolean @default(false)
  is_hybrid Boolean @default(false)
  is_onsite Boolean @default(false)

  @@index([company_id])
  @@index([posted_by_id])
}

model JobProgrammingLanguage {
  jobId                 Int
  programmingLanguageId Int

  job                 Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  programmingLanguage ProgramingLanguage @relation(fields: [programmingLanguageId], references: [id], onDelete: Cascade)

  @@id([jobId, programmingLanguageId])
  @@index([programmingLanguageId])
}

model JobProgrammingFramework {
  jobId                  Int
  programmingFrameworkId Int

  job                  Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  programmingFramework ProgramingFramework @relation(fields: [programmingFrameworkId], references: [id], onDelete: Cascade)

  @@id([jobId, programmingFrameworkId])
  @@index([programmingFrameworkId])
}

model UserAppliedJob {
  id                        Int       @id @default(autoincrement())
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user_id                   Int
  job                       Job       @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  job_id                    Int
  cover_letter              String
  resume_url                String
  status                    String    @default("APPLIED")
  applied_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  company_status            String    @default("PENDING")
  company_status_updated_at DateTime?
  deleted                   Boolean   @default(false)
  deleted_at                DateTime?

  @@unique([user_id, job_id])
  @@index([user_id])
  @@index([job_id])
}

model userFavoriteCompany {
  id         Int       @id @default(autoincrement())
  company_id Int
  user_id    Int
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id])
  @@index([user_id])
}
